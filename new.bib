@article{vihman1998,
	 ids={vihman_developmental_1998},
	title = {A developmental perspective on codeswitching: {Conversations} between a pair of bilingual siblings},
	volume = {2},
	issn = {13670069},
	doi = {10.1177/136700699800200103},
	abstract = {Addressed are the broader question of social motivation for code-switching as well as the more narrowly linguistic question of structural constraints, based on six recordings of conversations between a pair of bilingual siblings over a period of 4 years (aged 2:8-6:7 \& 5:11-9:10). Unmarked code-switching, emblematic of the children's dual identity as members of an Estonian family \& an English-speaking community, is found to characterize their interactions, with a shift from minimal intrasentential code-switching in the first recording (3\%), which has a roughly even balance of English \& Estonian turns for both siblings, to a mean of 12\% code-switching in the conversations that are largely in Estonian. The linguistic constraints formulated in the matrix language frame model are observed. Violations not found in adult code-switching, eg, the inclusion of system morphemes from the embedded language with grammatical agreement in the matrix language, are also observed but are rare. The two children are found to differ in "code-switching style," with the younger child allowing his two languages to interact more freely in switching grammatical elements \& sequences of content words, \& sometimes failing to inhibit switching in discourse with monolinguals. 7 Tables, 1 Figure, 1 Appendix, 60 References. Adapted from the source document},
	number = {1},
	journal = {International Journal of Bilingualism},
	author = {Vihman, Marilyn},
	year = {1998},
	keywords = {Bilingual siblings, Codeswitching, Estonian},
	pages = {45--84},
}

@article{gathercole2007,
	 ids={gathercole_miami_2007},
	title = {Miami and {North} {Wales}, {So} {Far} and {Yet} {So} {Near}: {A} {Constructivist} {Account} of {Morphosyntactic} {Development} in {Bilingual} {Children}},
	volume = {10},
	url = {http://www.tandfonline.com/doi/abs/10.2167/beb442.0},
	doi = {10.2167/beb442.0},
	abstract = {This paper proposes a constructivist account of the development of morphosyntax in bilinguals, based on an examination of two populations – English–Spanish bilinguals in Miami and English–Welsh bilinguals in North Wales. Despite sociocultural and sociolinguistic differences across these groups, the development of bilinguals in the two groups reveals core commonalities. These core commonalities are posited to be a by-product of normal processes of language development, as seen from a constructivist view. These processes are outlined, and predictions based on them are discussed regarding key issues in bilingualism research, including whether bilinguals' two languages develop as autonomous or interactive systems, whether bilingual development is parallel in pacing and sequence to monolingual development, and whether bilingual attainment in their two languages is similar to that of monolinguals.},
	number = {3},
	urldate = {2018-04-14},
	journal = {International Journal of Bilingual Education and Bilingualism},
	author = {Gathercole, Virginia C.M.},
	year = {2007},
	note = {Publisher: Taylor \& Francis Group},
	pages = {224--247},
}

