	pages = {82--100},
	file = {Full Text PDF:/Users/mbrxsvv2/Zotero/storage/R6ZFI3RA/Anderssen and Bentzen - 2013 - Cross-linguistic influence outside the syntax-prag.pdf:application/pdf;Snapshot:/Users/mbrxsvv2/Zotero/storage/WYREGQJR/stul.html:text/html},
}

