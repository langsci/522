	pages = {375--393},
	file = {Accepted Version:/Users/drasko/Zotero/storage/MS344Q9D/Treffers-Daller - 2019 - What Defines Language Dominance in Bilinguals.pdf:application/pdf},
}

@incollection{valdes2016,
	 ids={valdes_kroff_mixed_2016},
	series = {Issues in {Hispanic} and {Lusophone} {Linguistics}},
	title = {Mixed {NPs} in {Spanish}-{English} bilingual speech: {Using} a corpus-based approach to inform models of sentence processing},
	isbn = {978-90-272-5810-6 978-90-272-6667-5},
	shorttitle = {Using a corpus-based approach to inform models of sentence processing},
	url = {https://benjamins.com/catalog/ihll.11.12val},
	abstract = {Bilinguals speaking with other bilinguals engage in codeswitching (CS). CS is not a priori predictable, yet bilinguals suffer no appreciable costs to communication. One hypothesis explaining this ease is an exposure-driven account whereby speakers converge upon conventional production patterns, which may help guide comprehension. In this study, I quantify and investigate the use of grammatical gender in Spanish-English mixed noun phrases using a bilingual spoken language corpus. Results reveal a robust gender asymmetry where masculine gender is the default gender when switching into an English noun (e.g. un juice ‘themasc juice,’un cookie ‘themasc cookie’). In contrast, feminine-marked switches are infrequent and used with feminine translation equivalents (e.g. una cookie, ‘thefem cookie’). This asymmetry forms testable predictions for how bilinguals use grammatical gender in CS comprehension.},
	language = {en},
	urldate = {2025-05-29},
	booktitle = {Spanish-{English} {Codeswitching} in the {Caribbean} and the {US}},
	publisher = {John Benjamins Publishing Company},
