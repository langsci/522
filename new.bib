@article{herve2018,
	 ids={herve_development_2018},
	title = {The development of determiners in the context of {French}–{English} bilingualism: a study of cross-linguistic influence},
	volume = {45},
	issn = {0305-0009, 1469-7602},
	shorttitle = {The development of determiners in the context of {French}–{English} bilingualism},
	url = {https://www.cambridge.org/core/journals/journal-of-child-language/article/development-of-determiners-in-the-context-of-frenchenglish-bilingualism-a-study-of-crosslinguistic-influence/E2EDED99F8E97B2DEFAC0C70CD317850},
	doi = {10.1017/S0305000917000459},
	abstract = {This paper reports the preliminary results of a study examining the role of structural overlap, language exposure, and language use on cross-linguistic influence (CLI) in bilingual first language acquisition. We focus on the longitudinal development of determiners in a corpus of two French–English children between the ages of 2;4 and 3;7. The results display bi-directional CLI in the rate of development, i.e., accelerated development in English and a minor delay in French. Unidirectional CLI from English to French was instead observed in the significantly higher rate of ungrammatical determiner omissions in plural and generic contexts than in singular specific contexts in French. These findings suggest that other language-internal mechanisms may be at play. They also lend support to the role of expressive abilities on the magnitude of this phenomenon.},
	language = {en},
	number = {3},
	urldate = {2025-07-08},
	journal = {Journal of Child Language},
	author = {Hervé, Coralie and Serratrice, Ludovica},
