	volume = {1},
	issn = {1550-7076},
	url = {https://brill.com/view/journals/hlj/1/1/article-p1_3.xml},
	doi = {10.46538/hlj.1.1.1},
	abstract = {The “intergenerational transmission” of heritage languages (HLs) is crucial to the vitality of heritage language communities (especially for indigenous communities, where immigration is not a source of new speakers). We know, however, that HLs in the United States often do NOT survive well from one generation to the next as the shift to English takes place. In conjunction with the Second National Conference on Heritage Languages in America, a small group of researchers met to discuss priorities for research on intergenerational transmission of languages. Each of the ten researchers who participated prepared a short paper, posing research questions with some commentary to guide future research. Those papers form the major part of this article, covering topics related to language ecological patterns (in communities, families, and  institutions),  language ideology, measurement issues, and literacy.},
	language = {en},
	number = {1},
	urldate = {2025-07-31},
	journal = {Heritage Language Journal},
	author = {Kondo-Brown, Kimi},
	month = oct,
	year = {2001},
	pages = {1--25},
}